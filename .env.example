# Optional — upgrade the deterministic local rubric engine to an LLM.
# Without these, the app runs fully offline on the built-in engine.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Set a real secret in production (a fixed dev default exists for local runs).
# JWT_SECRET=

# Evidence retention (days). Uploads older than this are deleted and their
# database references cleared on server boot. Unset or 0 retains indefinitely
# (retention disabled). Production target is object storage with lifecycle
# rules; this governs the local-disk uploads under data/uploads.
# EVIDENCE_RETENTION_DAYS=90
